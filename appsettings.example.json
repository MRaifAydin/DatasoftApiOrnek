{
  // Bu dosyayı "appsettings.json" adıyla kopyalayıp bağlantı bilgilerini doldurun.
  // appsettings.json depoya eklenmez (.gitignore); gizli bilgiler yalnızca sizde kalır.
  //
  // Bağlantı bilgileri. Adresler entegrasyon TEST ortamına aittir.
  // Şifre ve anahtarı dosyada tutmak istemezseniz boş bırakıp ortam değişkeni verebilirsiniz:
  // DATASOFT_USERNAME, DATASOFT_PASSWORD, DATASOFT_API_KEY, DATASOFT_COMPANY_ID
  "Connection": {
    // Oturum (token) işlemlerinin yapıldığı servis.
    "SalesApiUrl": "https://cloudbeta.datasoft.com.tr:55/SalesApi/V2",

    // Ön muhasebe işlemlerinin (cari, stok, fatura) yapıldığı servis.
    "PreAccountingApiUrl": "https://cloudbeta.datasoft.com.tr:55/PreAccountingTenantApi/V2",

    // API kullanıcısının bağlı olduğu entegrasyon tanımının anahtarı (X-Api-Key başlığı).
    // Yalnızca o tanıma bağlı kullanıcılarla çalışır.
    "ApiKey": "",

    "Username": "",
    "Password": "",

    // Çalışılacak şirket; API kullanıcısı bu şirkete davet edilmiş olmalıdır.
    // null bırakılırsa kullanıcının varsayılan şirketi kullanılır.
    "CompanyId": null
  },

  // Oluşturulacak örnek cari. Bu kodla bir cari varsa yeni kart açılmaz, mevcut kart kullanılır.
  "Customer": {
    "Code": "ORN-MUS-001",
    "Title": "API ÖRNEK MÜŞTERİ LTD. ŞTİ.",

    // 10 haneli VKN. Kontrol hanesi sunucuda doğrulanır; rastgele 10 hane kabul edilmez.
    "TaxNumber": "4816029370",

    // Aşağıdaki dört alan adla yazılır; id'leri API'den aranarak bulunur.
    "TaxOffice": "Ulus Vergi Dairesi",
    "Country": "Türkiye",
    "City": "Ankara",
    "County": "Çankaya",

    // Mahalle, cadde ve sokaktan en az biri ile bina no zorunludur.
    "Neighborhood": "Kızılay",
    "Avenue": "Atatürk Bulvarı",
    "Street": "",
    "BuildingNo": "1",
    "PostCode": "06420",
    "FullAddress": "Atatürk Bulvarı No:1",

    "Email": "ornek.musteri@example.com"
  },

  // Oluşturulacak örnek stok. Bu kodla bir stok varsa yeni kart açılmaz, mevcut kart kullanılır.
  "Stock": {
    "Code": "ORN-URUN-001",
    "Name": "API Örnek Ürün",

    // Şirkette seçili ölçü birimlerinden birinin adı.
    "Unit": "Adet",

    // KDV oranı (%); sistemde tanımlı oranlardan biri olmalıdır: 1, 8, 10, 18, 20
    "VatRate": 20,

    // KDV hariç satış fiyatı.
    "SalePrice": 100.00
  },

  // Yukarıdaki cariye, yukarıdaki stoktan tek satırlık satış faturası.
  // Fatura yalnızca kaydedilir; e-Fatura / e-Arşiv olarak gönderilmez.
  "Invoice": {
    // Belge cinsinin kodu; S4100 = Fatura.
    "DocumentCode": "S4100",

    "Quantity": 2,

    // KDV hariç birim fiyat; null ise stok kartındaki satış fiyatı kullanılır.
    "UnitPrice": null,

    // Kullanılacak seri (ör. "AKA"); boşsa belge türünün varsayılan serisi kullanılır.
    "SerialCode": "",

    // Yalnızca cari e-Fatura mükellefiyse kullanılır (ör. "Temel Fatura", "Ticari Fatura").
    // Boşsa satış tipini destekleyen ilk senaryo seçilir.
    "Scenario": "",

    "Description": "API örnek uygulaması ile oluşturulmuştur."
  }
}
